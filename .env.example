# Documentation only. Run scripts/setup.ps1 or scripts/setup.sh to generate .env.
# Never commit real values. All three variables are required by Compose.
RELAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
RELAY_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
DATABASE_PASSWORD=replace-with-a-random-local-database-password
